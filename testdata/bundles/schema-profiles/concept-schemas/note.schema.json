{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-factile-concept-schema": {
    "format": "concept-schema/v1",
    "id": "example.note",
    "concept_type": "Note"
  },
  "type": "object",
  "required": ["type", "owner", "state"],
  "properties": {
    "type": {"const": "Note"},
    "owner": {"type": "string", "minLength": 1},
    "state": {"enum": ["draft", "ready"]}
  },
  "additionalProperties": true
}
